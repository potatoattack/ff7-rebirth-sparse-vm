+static int amdgpu_vm_ff7_batch_begin(struct amdgpu_vm_update_ctx *ctx,
+				   struct amdgpu_vm_ff7_batch_state *b,
+				   bool allow_override)
+{
+	struct amdgpu_vm *vm = ctx->vm;
+	int r;
+
+	if (!drm_dev_enter(adev_to_drm(ctx->adev), &b->idx))
+		return -ENODEV;
+	b->tlb_cb = kmalloc_obj(*b->tlb_cb);
+	if (!b->tlb_cb) {
+		drm_dev_exit(b->idx);
+		return -ENOMEM;
+	}
+	b->params.adev = ctx->adev;
+	b->params.vm = vm;
+	b->params.needs_flush = true;
+	b->params.ff7_e04_batch = true;
+	b->params.override_pte = allow_override && ctx->adev->gmc.override_pte;
+	INIT_LIST_HEAD(&b->params.tlb_flush_waitlist);
+	amdgpu_vm_eviction_lock(vm);
+	if (vm->evicting) {
+		r = -EBUSY;
+		goto fail;
+	}
+	if (!dma_fence_is_signaled(vm->last_unlocked)) {
+		struct dma_fence *tmp = dma_fence_get_stub();
+		amdgpu_bo_fence(vm->root.bo, vm->last_unlocked, true);
+		swap(vm->last_unlocked, tmp);
+		dma_fence_put(tmp);
+	}
+	r = vm->update_funcs->prepare(&b->params, &ctx->sync,
+				     AMDGPU_KERNEL_JOB_ID_VM_UPDATE_RANGE);
+	if (r)
+		goto fail;
+	b->active = true;
+	return 0;
+fail:
+	amdgpu_vm_eviction_unlock(vm);
+	kfree(b->tlb_cb);
+	drm_dev_exit(b->idx);
+	return r;
+}
+
+static void amdgpu_vm_ff7_batch_abort(struct amdgpu_vm_ff7_batch_state *b)
+{
+	/* Batch SDMA updates cannot auto-submit; PT traversal is leaf-only. */
+	amdgpu_job_free(b->params.job);
+	WARN_ON(!list_empty(&b->params.tlb_flush_waitlist));
+	amdgpu_vm_eviction_unlock(b->params.vm);
+	kfree(b->tlb_cb);
+	drm_dev_exit(b->idx);
+	b->active = false;
+}
+
+static int amdgpu_vm_ff7_batch_end(struct amdgpu_vm_ff7_batch_state *b,
+				 struct dma_fence **fence)
+{
+	int r = b->params.vm->update_funcs->commit(&b->params, fence);
+
+	if (r)
+		return r;
+	amdgpu_vm_tlb_flush(&b->params, fence, b->tlb_cb);
+	b->tlb_cb = NULL;
+	WARN_ON(!list_empty(&b->params.tlb_flush_waitlist));
+	amdgpu_vm_eviction_unlock(b->params.vm);
+	drm_dev_exit(b->idx);
+	b->active = false;
+	return 0;
+}
