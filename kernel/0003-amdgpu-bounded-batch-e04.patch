+static int amdgpu_gem_ff7_batch_ioctl(struct drm_device *dev,
+		struct drm_amdgpu_gem_va *header, struct drm_file *filp)
+{
+	const u32 flags_mask = AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE |
+		AMDGPU_VM_PAGE_EXECUTABLE | AMDGPU_VM_MTYPE_MASK | AMDGPU_VM_PAGE_NOALLOC;
+	struct amdgpu_device *adev = drm_to_adev(dev);
+	struct amdgpu_fpriv *fpriv = filp->driver_priv;
+	struct amdgpu_vm *vm = &fpriv->vm;
+	struct drm_amdgpu_gem_va *entries;
+	struct drm_gem_object *gobj;
+	struct amdgpu_bo *bo;
+	struct amdgpu_bo_va *bo_va;
+	struct amdgpu_vm_update_ctx ctx;
+	struct drm_exec exec;
+	unsigned int count, i, j;
+	u64 end, vm_size;
+	int r = 0;
+
+	if (!header->handle || header->_pad || header->flags || header->map_size ||
+	    header->vm_timeline_point || header->vm_timeline_syncobj_out ||
+	    header->num_syncobj_handles || header->input_fence_syncobj_handles ||
+	    !header->offset_in_bo || header->offset_in_bo > AMDGPU_FF7_BATCH_MAX)
+		return -EINVAL;
+	count = header->offset_in_bo;
+	entries = memdup_user(u64_to_user_ptr(header->va_address),
+			     count * sizeof(*entries));
+	if (IS_ERR(entries))
+		return PTR_ERR(entries);
+	vm_size = adev->vm_manager.max_pfn * AMDGPU_GPU_PAGE_SIZE - AMDGPU_VA_RESERVED_TOP;
+	for (i = 0; i < count; ++i) {
+		struct drm_amdgpu_gem_va *e = &entries[i];
+		if (e->handle != header->handle || e->_pad ||
+		    e->operation != AMDGPU_VA_OP_REPLACE || (e->flags & ~flags_mask) ||
+		    e->map_size != SZ_64K || !IS_ALIGNED(e->va_address, SZ_64K) ||
+		    !IS_ALIGNED(e->offset_in_bo, SZ_64K) || e->vm_timeline_point ||
+		    e->vm_timeline_syncobj_out || e->num_syncobj_handles ||
+		    e->input_fence_syncobj_handles ||
+		    e->va_address < AMDGPU_VA_RESERVED_BOTTOM ||
+		    (e->va_address >= AMDGPU_GMC_HOLE_START && e->va_address < AMDGPU_GMC_HOLE_END)) {
+			r = -EINVAL;
+			goto free_entries;
+		}
+		e->va_address &= AMDGPU_GMC_HOLE_MASK;
+		if (check_add_overflow(e->va_address, e->map_size, &end) || end > vm_size) {
+			r = -EINVAL;
+			goto free_entries;
+		}
+		for (j = 0; j < i; ++j) {
+			if (entries[j].va_address == e->va_address) {
+				r = -EINVAL;
+				goto free_entries;
+			}
+		}
+	}
+	gobj = drm_gem_object_lookup(filp, header->handle);
+	if (!gobj) {
+		r = -ENOENT;
+		goto free_entries;
+	}
+	bo = gem_to_amdgpu_bo(gobj);
+	amdgpu_vm_update_ctx_init(&ctx, adev, vm);
+	drm_exec_init(&exec, DRM_EXEC_INTERRUPTIBLE_WAIT | DRM_EXEC_IGNORE_DUPLICATES, 0);
+	drm_exec_until_all_locked(&exec) {
+		r = drm_exec_lock_obj(&exec, gobj);
+		drm_exec_retry_on_contention(&exec);
+		if (r)
+			goto unlock;
+		r = amdgpu_vm_lock_pd(vm, &exec, 2);
+		drm_exec_retry_on_contention(&exec);
+		if (r)
+			goto unlock;
+	}
+	bo_va = amdgpu_vm_bo_find(vm, bo);
+	/* EOPNOTSUPP is allowed only BEFORE modifying any mapping. */
+	if (!bo_va || adev->debug_vm || !amdgpu_vm_ready(vm) ||
+	    vm->update_funcs != &amdgpu_vm_sdma_funcs ||
+	    !amdgpu_vm_is_bo_always_valid(vm, bo) || bo_va->base.moved ||
+	    bo_va->cleared || bo_va->is_xgmi || bo_va->userq_va_mapped ||
+	    !list_empty(&bo_va->invalids) || !bo->tbo.resource ||
+	    bo->tbo.resource->mem_type != TTM_PL_VRAM ||
+	    amdgpu_bo_encrypted(bo)) {
+		r = -EOPNOTSUPP;
+		goto unlock;
+	}
+	for (i = 0; i < count; ++i) {
+		struct drm_amdgpu_gem_va *e = &entries[i];
+		struct amdgpu_bo_va_mapping *old;
+		u64 start = e->va_address >> AMDGPU_GPU_PAGE_SHIFT;
+		if (check_add_overflow(e->offset_in_bo, e->map_size, &end) ||
+		    end > amdgpu_bo_size(bo)) {
+			r = -EINVAL;
+			goto unlock;
+		}
+		old = amdgpu_vm_bo_lookup_mapping(vm, start);
+		if (!old || old->bo_va != bo_va || old->start != start ||
+		    old->last != start + SZ_64K / AMDGPU_GPU_PAGE_SIZE - 1) {
+			r = -EOPNOTSUPP;
+			goto unlock;
+		}
+	}
+	for (i = 0; i < count; ++i) {
+		struct drm_amdgpu_gem_va *e = &entries[i];
+		r = amdgpu_vm_bo_replace_map(&ctx, bo_va, e->va_address,
+					    e->offset_in_bo, e->map_size, e->flags);
+		if (r)
+			goto unlock;
+	}
+	r = amdgpu_vm_ff7_batch_replace(&ctx, bo_va);
+	if (!r)
+		r = amdgpu_vm_update_pdes(adev, vm, false);
+unlock:
+	amdgpu_vm_update_ctx_fini(&ctx);
+	drm_exec_fini(&exec);
+	drm_gem_object_put(gobj);
+free_entries:
+	amdgpu_vm_ff7_batch_note(count, r);
+	kfree(entries);
+	return r;
+}
