+		(long long)atomic64_read(&ff7_e04_calls),
+		(long long)atomic64_read(&ff7_e04_entries),
+		(long long)atomic64_read(&ff7_e04_ranges),
+		(long long)atomic64_read(&ff7_e04_jobs),
+		(long long)atomic64_read(&ff7_e04_unsupported),
+		(long long)atomic64_read(&ff7_e04_errors));
+}
+static const struct kernel_param_ops ff7_vm_e04_stats_ops = {
+	.get = ff7_vm_e04_stats_get,
+};
