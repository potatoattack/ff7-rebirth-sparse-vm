+/* E04: bounded multi-range submissions; no changed defaults. */
+static unsigned int ff7_vm_batch_replace = 1;
+module_param_named(ff7_vm_batch_replace, ff7_vm_batch_replace, uint, 0444);
+static atomic64_t ff7_e04_calls, ff7_e04_entries, ff7_e04_jobs;
+static atomic64_t ff7_e04_ranges, ff7_e04_unsupported, ff7_e04_errors;
+void amdgpu_vm_ff7_batch_job(void) { atomic64_inc(&ff7_e04_jobs); }
+void amdgpu_vm_ff7_batch_note(unsigned int count, int result)
+{
+	if (!result) {
+		atomic64_inc(&ff7_e04_calls);
+		atomic64_add(count, &ff7_e04_entries);
+	} else if (result == -EOPNOTSUPP) {
+		atomic64_inc(&ff7_e04_unsupported);
+	} else {
+		atomic64_inc(&ff7_e04_errors);
+	}
+}
+static int ff7_vm_e04_stats_get(char *buffer, const struct kernel_param *kp)
+{
+	return scnprintf(buffer, PAGE_SIZE,
