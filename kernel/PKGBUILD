export KBUILD_BUILD_USER=sparse-vm
export KBUILD_BUILD_HOST=arch

prepare() {
  cd "$_srcname"
  local patch
  for patch in "${_patches[@]}"; do
    patch --batch --forward --fuzz=0 -Np1 -i "$srcdir/$patch"
  done
  cp "$srcdir/config" .config
  printf '%s\n' "-$pkgrel" > localversion.10-pkgrel
  printf '%s\n' '-cachyos-sparse-vm' > localversion.20-pkgname
  scripts/config --set-str LOCALVERSION '' --disable LOCALVERSION_AUTO
  scripts/config --disable AUTOFDO_CLANG --disable PROPELLER_CLANG
  make LLVM=1 olddefconfig
  make -s LLVM=1 kernelrelease > version
  [[ $(<version) == "$pkgver-$pkgrel-cachyos-sparse-vm" ]]
}

build() {
  cd "$_srcname"
  make LLVM=1 all
}

package_linux-cachyos-sparse-vm() {
  depends=(coreutils kmod initramfs)
  optdepends=('linux-firmware: firmware for supported devices'
              'wireless-regdb: wireless regulatory database')
  provides=(VIRTUALBOX-GUEST-MODULES WIREGUARD-MODULE NTSYNC-MODULE)
  cd "$_srcname"
  local modulesdir="$pkgdir/usr/lib/modules/$(<version)"
  install -Dm644 "$(make -s LLVM=1 image_name)" "$modulesdir/vmlinuz"
  printf '%s\n' "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"
  install -Dm644 .config "$modulesdir/config"
  ZSTD_CLEVEL=10 make LLVM=1 INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install
  rm -f "$modulesdir/build" "$modulesdir/source"
}

package_linux-cachyos-sparse-vm-headers() {
  pkgdesc='Headers and scripts for the sparse VM kernel'
  depends=("linux-cachyos-sparse-vm=$pkgver-$pkgrel" binutils glibc libelf
           libgcc openssl pahole xxhash zlib zstd clang llvm lld)
  provides=(LINUX-HEADERS)
  cd "$_srcname"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
  cp -a scripts include "$builddir/"
  cp -a arch/x86/include "$builddir/arch/x86/"
  install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s
  install -Dt "$builddir/tools/objtool" tools/objtool/objtool
  if [[ -f tools/bpf/resolve_btfids/resolve_btfids ]]; then
    install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids
  fi
  if [[ -f tools/bpf/bpftool/vmlinux.h ]]; then
    install -Dt "$builddir/tools/bpf/bpftool" -m644 tools/bpf/bpftool/vmlinux.h
  fi
  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h
  find . -name 'Kconfig*' -exec install -Dm644 '{}' "$builddir/{}" \;
  if compgen -G 'rust/*.rmeta' > /dev/null; then
    install -Dt "$builddir/rust" -m644 rust/*.rmeta
  fi
  if compgen -G 'rust/*.so' > /dev/null; then
    install -Dt "$builddir/rust" rust/*.so
  fi
  make LLVM=1 INSTALL_MOD_PATH="$pkgdir/usr" vdso_install link=
  find -L "$builddir" -type l -delete
  find "$builddir" -type f -name '*.o' -delete
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}
