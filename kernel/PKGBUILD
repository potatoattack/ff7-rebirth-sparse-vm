  0005-amdgpu-explicit-batch-e12.patch
  0006-amdgpu-explicit-direct-e13.patch
  0007-amdgpu-partial-split-guard-e24.patch
  0008-amdgpu-leaf-retention-e27.patch
  0009-amdgpu-per-vm-opt-in.patch
)
source=("https://github.com/CachyOS/linux/releases/download/$_srcname/$_srcname.tar.gz"
