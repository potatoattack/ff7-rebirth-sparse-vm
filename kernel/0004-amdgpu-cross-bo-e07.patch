+/* The shared reservation is already held through amdgpu_vm_lock_pd().
+ * Reject other reservation owners before reading their placement/state.
+ * Retain E04's stable VRAM restrictions for both the old and target BO.
+ */
+static bool amdgpu_gem_ff7_old_bo_eligible(struct amdgpu_vm *vm,
+					struct amdgpu_bo_va *old)
+{
+	struct amdgpu_bo *bo = old->base.bo;
+
+	if (!amdgpu_vm_is_bo_always_valid(vm, bo))
+		return false;
+	dma_resv_assert_held(bo->tbo.base.resv);
+	return !old->base.moved && !old->cleared && !old->is_xgmi &&
+		!old->userq_va_mapped && list_empty(&old->invalids) &&
+		bo->tbo.resource && bo->tbo.resource->mem_type == TTM_PL_VRAM &&
+		!amdgpu_bo_encrypted(bo);
+}
+
+/* E04 ABI; E07 optionally admits exact cross-BO 64 KiB replacements. */
