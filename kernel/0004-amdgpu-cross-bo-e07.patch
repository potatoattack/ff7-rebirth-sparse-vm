 }
 
-/* Private E04 ABI; only existing same-BO 64 KiB VRAM replacements. */
+/* E07 changes only the private E04 operation. Read once per vector. */
+static unsigned int ff7_vm_cross_bo;
+static unsigned int ff7_vm_cross_bo_api = 1;
+static int ff7_vm_cross_bo_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int mode;
+	int r = kstrtouint(val, 0, &mode);
+
+	if (r || mode > 1)
+		return r ?: -EINVAL;
+	WRITE_ONCE(*(unsigned int *)kp->arg, mode);
+	return 0;
+}
+static const struct kernel_param_ops ff7_vm_cross_bo_ops = {
+	.set = ff7_vm_cross_bo_set,
+	.get = param_get_uint,
+};
+module_param_cb(ff7_vm_cross_bo, &ff7_vm_cross_bo_ops, &ff7_vm_cross_bo, 0644);
+module_param_named(ff7_vm_cross_bo_api, ff7_vm_cross_bo_api, uint, 0444);
+
+/* First unsupported condition only. Entries after that are not inspected. */
+enum ff7_e07_reason {
+	FF7_E07_ACCEPTED, FF7_E07_OTHER_BO, FF7_E07_SHAPE, FF7_E07_SOURCE,
+	FF7_E07_LEAF, FF7_E07_TARGET, FF7_E07_MISSING, FF7_E07_ERROR,
+	FF7_E07_REASONS
+};
+static atomic64_t ff7_e07_reasons[FF7_E07_REASONS];
+static atomic64_t ff7_e07_cross_entries;
+static int ff7_vm_e07_stats_get(char *buffer, const struct kernel_param *kp)
+{
+	return scnprintf(buffer, PAGE_SIZE,
+		"accepted=%lld other_bo=%lld shape=%lld source=%lld leaf=%lld target=%lld missing=%lld errors=%lld cross_entries=%lld\n",
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_ACCEPTED]),
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_OTHER_BO]),
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_SHAPE]),
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_SOURCE]),
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_LEAF]),
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_TARGET]),
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_MISSING]),
+		(long long)atomic64_read(&ff7_e07_reasons[FF7_E07_ERROR]),
+		(long long)atomic64_read(&ff7_e07_cross_entries));
+}
+static const struct kernel_param_ops ff7_vm_e07_stats_ops = {
+	.get = ff7_vm_e07_stats_get,
+};
+module_param_cb(ff7_vm_e07_stats, &ff7_vm_e07_stats_ops, NULL, 0444);
