+/* E07 preflight: no allocation, eviction, emission or hierarchy changes.
+ * An aligned 64 KiB interval fits in one leaf when block_size > 4. */
+bool amdgpu_vm_ff7_has_64k_leaf(struct amdgpu_device *adev,
+			      struct amdgpu_vm *vm, uint64_t start)
+{
+	struct amdgpu_vm_pt_cursor cursor;
+
+	dma_resv_assert_held(vm->root.bo->tbo.base.resv);
+	if ((start & 15) || adev->vm_manager.block_size <= 4)
+		return false;
+	amdgpu_vm_pt_start(adev, vm, start, &cursor);
+	while (cursor.level != AMDGPU_VM_PTB) {
+		if (!amdgpu_vm_pt_descendant(adev, &cursor))
+			return false;
+	}
+	return cursor.entry && cursor.entry->bo;
 }
 
