+/*
+ * E03 changes only a directly requested, immediately applied REPLACE. The
+ * replacement must be the sole pending mapping of this BO and cover every
+ * freed interval. All other cases retain clear-then-map behavior.
+ *
+ * Unmap synchronization is gathered BEFORE the write. The write requests
+ * the same TLB invalidation as the omitted clear, and its fence is published
+ * to vm->last_update before releasing any old PRT references. The range
+ * writer, SDMA DONT_PIPELINE rule and page-table retirement remain unchanged.
+ */
+int amdgpu_vm_ff7_replace(struct amdgpu_vm_update_ctx *ctx,
+			  struct amdgpu_bo_va *bo_va)
+{
+	struct amdgpu_bo_va_mapping *mapping, *next, *replacement;
+	struct dma_fence *fence;
+	unsigned int eliminated = 0;
+	bool direct = ctx->ff7_e03_mode == 2;
+	int r;
+
+	if (ctx->ff7_e03_mode)
+		atomic64_inc(&ff7_e03_ops[ctx->ff7_e03_mode - 1]);
+
+	/* Narrow the first experiment to SDMA and one pending new range. */
+	direct &= ctx->vm->update_funcs == &amdgpu_vm_sdma_funcs &&
+		  !ctx->explicit_sync_unmap && !bo_va->base.moved &&
+		  !bo_va->cleared && !list_empty(&ctx->freed) &&
+		  list_is_singular(&bo_va->invalids);
+	if (direct) {
+		replacement = list_first_entry(&bo_va->invalids,
+				struct amdgpu_bo_va_mapping, list);
+		list_for_each_entry(mapping, &ctx->freed, list) {
+			if (mapping->start < replacement->start ||
+			    mapping->last > replacement->last) {
+				direct = false;
+				break;
+			}
+			++eliminated;
+		}
+	}
+
+	if (!direct) {
+		if (ctx->ff7_e03_mode == 2)
+			atomic64_inc(&ff7_e03_fallback);
+		r = amdgpu_vm_clear_freed(ctx, &ctx->vm->last_update);
+		return r ? r : amdgpu_vm_bo_update(ctx, bo_va, false);
+	}
+
+	r = amdgpu_vm_update_ctx_ensure_unmap_synced(ctx);
+	if (r)
+		return r;
+	ctx->ff7_direct_active = true;
+	r = amdgpu_vm_bo_update(ctx, bo_va, false);
+	ctx->ff7_direct_active = false;
+	if (r)
+		return r; /* freed mappings remain owned by ctx for normal recovery */
+
+	if (amdgpu_vm_is_bo_always_valid(ctx->vm, bo_va->base.bo))
+		fence = dma_fence_get(ctx->vm->last_update);
+	else
+		fence = dma_fence_get(bo_va->last_pt_update);
+	/* Retain the same VM-wide completion dependency as the old clear. */
+	dma_fence_put(ctx->vm->last_update);
+	ctx->vm->last_update = dma_fence_get(fence);
+	list_for_each_entry_safe(mapping, next, &ctx->freed, list) {
+		list_del(&mapping->list);
+		amdgpu_vm_free_mapping(ctx->adev, ctx->vm, mapping, fence);
+	}
+	dma_fence_put(fence);
+	atomic64_add(eliminated, &ff7_e03_eliminated);
+	return 0;
 }
 
