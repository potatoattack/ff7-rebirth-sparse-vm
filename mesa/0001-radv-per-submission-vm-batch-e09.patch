+
+bool
+radv_amdgpu_ff7_init(struct radv_amdgpu_winsys *ws, bool is_virtio)
+{
+   const char *mode = getenv("RADV_FF7_VM_MODE");
+   if (!mode || !*mode || !strcmp(mode, "off"))
+      return true;
+   /* This experiment has only been checked for the supplied NAVI31 hardware. */
+   if (is_virtio || ws->info.pci_id != 0x744c)
+      return true;
+   if (!strcmp(mode, "baseline"))
+      ws->ff7_vm_mode = FF7_VM_BASELINE;
+   else if (!strcmp(mode, "direct"))
+      ws->ff7_vm_mode = FF7_VM_DIRECT_MODE;
+   else if (!strcmp(mode, "batch"))
+      ws->ff7_vm_mode = FF7_VM_BATCH_MODE;
+   else {
+      fprintf(stderr, "FF7_E05: invalid RADV_FF7_VM_MODE.\n");
+      return false;
+   }
+   char marker[16] = {0};
+   FILE *f = fopen("/sys/module/amdgpu/parameters/ff7_vm_batch_replace", "r");
+   if (f) {
+      if (!fgets(marker, sizeof(marker), f))
+         marker[0] = 0;
+      fclose(f);
+   }
+   if (strcmp(marker, "1\n")) {
+      fprintf(stderr, "FF7_E05: expected E04 kernel marker missing; rejecting requested mode.\n");
+      return false;
+   }
+   const char *split = getenv("RADV_FF7_SPLIT_REJECTED");
+   if (split && strcmp(split, "0") && strcmp(split, "1")) {
+      fprintf(stderr, "FF7_E09: RADV_FF7_SPLIT_REJECTED must be 0 or 1.\n");
+      return false;
+   }
+   ws->ff7_split_rejected = split && !strcmp(split, "1");
+   if (ws->ff7_split_rejected && ws->ff7_vm_mode != FF7_VM_BATCH_MODE)
+      return false;
+   fprintf(stderr, "FF7_E09_RADV_v1: pid=%ld mode=%s split_rejected=%u device=0x744c max_entries=16\n",
+           (long)getpid(), mode, ws->ff7_split_rejected);
+   return true;
+}
+
+static int
+radv_amdgpu_ff7_send(void *user, struct drm_amdgpu_gem_va *va)
+{
+   struct radv_amdgpu_winsys *ws = user;
+   return drm_ioctl_write_read(ws->fd, DRM_AMDGPU_GEM_VA, va, sizeof(*va));
+}
+
+static VkResult
+radv_amdgpu_sparse_begin(struct radeon_winsys *rws, void **context)
+{
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(rws);
+   *context = NULL;
+   if (!ws->ff7_vm_mode)
+      return VK_SUCCESS;
+   struct ff7_vm_batch *batch = calloc(1, sizeof(*batch));
+   if (!batch)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   batch->mode = ws->ff7_vm_mode;
+   batch->split_rejected = ws->ff7_split_rejected;
+   batch->send = radv_amdgpu_ff7_send;
+   batch->user = ws;
+   *context = batch;
+   return VK_SUCCESS;
+}
+
+static VkResult
+radv_amdgpu_sparse_end(struct radeon_winsys *rws, void *context, bool abort)
+{
+   (void)rws;
+   struct ff7_vm_batch *batch = context;
+   if (!batch)
+      return VK_SUCCESS;
+   /* On any earlier error, discard unsent entries and let the caller mark
+    * device lost. Never replay a partly failed submission. */
+   int r = abort ? batch->error : ff7_vm_flush(batch);
+   if (r)
+      fprintf(stderr, "FF7_E05: sparse batch failed (%d), pending=%u; device-lost path.\n", r, batch->count);
+   free(batch);
+   return r ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+}
