--- a/src/amd/vulkan/winsys/amdgpu/ff7_vm_batch.h
+++ b/src/amd/vulkan/winsys/amdgpu/ff7_vm_batch.h
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: MIT
+ * Private E09 experiment: one context per RADV sparse submission.
+ * The caller must finish/abort before reporting submission completion.
+ * No global batching state, cross-submission deferral or added GPU waits.
+ */
+#ifndef FF7_VM_BATCH_H
+#define FF7_VM_BATCH_H
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include "drm-uapi/amdgpu_drm.h"
+
+#define FF7_VM_BATCH_OP 0xf704u
+#define FF7_VM_BATCH_MAX 16u
+#define FF7_VM_EXPLICIT (1u << 10)
+#define FF7_VM_ACCOUNT (1u << 11)
+#define FF7_VM_DIRECT (1u << 12)
+enum ff7_vm_mode { FF7_VM_OFF, FF7_VM_BASELINE, FF7_VM_DIRECT_MODE, FF7_VM_BATCH_MODE };
+struct ff7_vm_counts {
+   uint64_t calls, batch_attempts, batches, entries, scalar, fallback, unsupported, splits, errors;
+};
+typedef int (*ff7_vm_send)(void *user, struct drm_amdgpu_gem_va *va);
+struct ff7_vm_batch {
+   enum ff7_vm_mode mode;
+   unsigned count;
+   bool split_rejected;
+   int error;
+   ff7_vm_send send;
+   void *user;
+   struct ff7_vm_counts stats;
+   struct drm_amdgpu_gem_va entries[FF7_VM_BATCH_MAX];
+};
+_Static_assert(sizeof(struct drm_amdgpu_gem_va)==64, "E04 kernel GEM_VA ABI");
+
+static inline int
+ff7_vm_error(struct ff7_vm_batch *b, int r)
+{
+   if (!b->error)
+      ++b->stats.errors;
+   b->error = r;
+   return r;
+}
+
+static inline int
+ff7_vm_scalar(struct ff7_vm_batch *b, const struct drm_amdgpu_gem_va *entry)
+{
+   struct drm_amdgpu_gem_va va = *entry;
+   va.flags |= FF7_VM_ACCOUNT;
+   if (b->mode != FF7_VM_BASELINE)
+      va.flags |= FF7_VM_DIRECT;
+   ++b->stats.scalar;
+   int r = b->send(b->user, &va);
+   return r ? ff7_vm_error(b, r) : 0;
+}
+
+/* Retry only EOPNOTSUPP: the private kernel operation guarantees no
+ * mutation on that result. Process contiguous left then right portions in
+ * original order; no reordering, cross-submission deferral, or GPU waits.
+ * Stop subdividing at two entries. A rejected 16-entry vector therefore
+ * uses at most 15 batch attempts and 16 scalar calls, recursion depth four.
+ * Every other error is terminal, including after an earlier portion commits.
+ */
+static inline int
+ff7_vm_send_entries(struct ff7_vm_batch *b,
+                    const struct drm_amdgpu_gem_va *entries, unsigned count)
+{
+   struct drm_amdgpu_gem_va header = {
+      .handle = entries[0].handle, .operation = FF7_VM_BATCH_OP,
+      .va_address = (uint64_t)(uintptr_t)entries, .offset_in_bo = count,
+   };
+   ++b->stats.batch_attempts;
+   int r = b->send(b->user, &header);
+   if (r == -EOPNOTSUPP) {
+      ++b->stats.unsupported;
+      if (b->split_rejected && count > 2) {
+         unsigned left = count / 2;
+         ++b->stats.splits;
+         r = ff7_vm_send_entries(b, entries, left);
+         return r ? r : ff7_vm_send_entries(b, entries + left, count - left);
+      }
+      b->stats.fallback += count;
+      for (unsigned i = 0; i < count; ++i) {
+         r = ff7_vm_scalar(b, &entries[i]);
+         if (r)
+            return r;
+      }
+   } else if (r) {
+      return ff7_vm_error(b, r);
+   } else {
+      ++b->stats.batches;
+      b->stats.entries += count;
+   }
+   return 0;
+}
+
+static inline int
+ff7_vm_flush(struct ff7_vm_batch *b)
+{
+   if (b->error)
+      return b->error;
+   if (!b->count)
+      return 0;
+   int r = ff7_vm_send_entries(b, b->entries, b->count);
+   if (!r)
+      b->count = 0;
+   return r;
+}
+
+static inline int
+ff7_vm_push(struct ff7_vm_batch *b, const struct drm_amdgpu_gem_va *va)
+{
+   if (b->error)
+      return b->error;
+   if (b->mode < FF7_VM_BASELINE || b->mode > FF7_VM_BATCH_MODE || !b->send ||
+       va->operation != AMDGPU_VA_OP_REPLACE ||
+       (va->flags & (FF7_VM_EXPLICIT | FF7_VM_ACCOUNT | FF7_VM_DIRECT | AMDGPU_VM_DELAY_UPDATE)) ||
+       va->_pad || va->vm_timeline_point || va->vm_timeline_syncobj_out ||
+       va->num_syncobj_handles || va->input_fence_syncobj_handles)
+      return ff7_vm_error(b, -EINVAL);
+   ++b->stats.calls;
+   bool eligible = va->handle && !(va->flags & AMDGPU_VM_PAGE_PRT) &&
+                   va->map_size == 65536 && !(va->va_address & 65535) &&
+                   !(va->offset_in_bo & 65535);
+   if (b->mode != FF7_VM_BATCH_MODE || !eligible) {
+      int r = ff7_vm_flush(b);
+      if (r)
+         return r;
+      if (b->mode == FF7_VM_BATCH_MODE)
+         ++b->stats.fallback;
+      return ff7_vm_scalar(b, va);
+   }
+   bool flush = b->count && (b->entries[0].handle != va->handle ||
+                             b->entries[0].flags != va->flags);
+   for (unsigned i = 0; i < b->count; ++i)
+      flush |= b->entries[i].va_address == va->va_address;
+   if (flush) {
+      int r = ff7_vm_flush(b);
+      if (r)
+         return r;
+   }
+   b->entries[b->count++] = *va;
+   return b->count == FF7_VM_BATCH_MAX ? ff7_vm_flush(b) : 0;
+}
+#endif
