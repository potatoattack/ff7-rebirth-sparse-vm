+/* E16 diagnostic counters add no per-destruction file I/O or GPU waits.
+ * Layout: magic/version/pid/mode, candidate physical/virtual/other,
+ * completed explicit physical/virtual, completed implicit, errors, reserved.
+ */
+static bool
+radv_amdgpu_ff7_destroy_init(struct radv_amdgpu_winsys *ws)
+{
+   const char *mode = getenv("RADV_FF7_EXPLICIT_DESTROY");
+   const char *dir = getenv("RADV_FF7_DESTROY_STATS_DIR");
+   if (!mode && !dir)
+      return true;
+   if (!mode || (strcmp(mode, "0") && strcmp(mode, "1")) || !ws->base.ff7_explicit_unmap)
+      return false;
+   ws->ff7_explicit_destroy = !strcmp(mode, "1");
+   if (dir) {
+      char path[4096];
+      int n = snprintf(path, sizeof(path), "%s/destroy-%ld-%p.bin", dir, (long)getpid(), (void *)ws);
+      if (n < 0 || (size_t)n >= sizeof(path))
+         return false;
+      int fd = open(path, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+      if (fd < 0)
+         return false;
+      if (ftruncate(fd, 4096)) {
+         close(fd);
+         return false;
+      }
+      void *map = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+      close(fd);
+      if (map == MAP_FAILED)
+         return false;
+      ws->ff7_destroy_stats = map;
+      ws->ff7_destroy_stats[0] = UINT64_C(0x313645374646);
+      ws->ff7_destroy_stats[1] = 1;
+      ws->ff7_destroy_stats[2] = getpid();
+      ws->ff7_destroy_stats[3] = ws->ff7_explicit_destroy;
+   }
+   fprintf(stderr, "FF7_E16_RADV_v1: pid=%ld explicit_destroy=%u scope=api_owned kernel_lifetime_guard=retained\n",
+           (long)getpid(), ws->ff7_explicit_destroy);
+   return true;
+}
+
+void
+radv_amdgpu_ff7_destroy_finish(struct radv_amdgpu_winsys *ws)
+{
+   if (ws->ff7_destroy_stats) {
+      munmap(ws->ff7_destroy_stats, 4096);
+      ws->ff7_destroy_stats = NULL;
+   }
+}
+
+static uint64_t
+radv_amdgpu_ff7_destroy_begin(struct radv_amdgpu_winsys *ws, struct radv_amdgpu_winsys_bo *bo)
+{
+   bool eligible = bo->base.ff7_api_owned && (bo->base.is_virtual || bo->base.is_local);
+   if (ws->ff7_destroy_stats)
+      p_atomic_inc(&ws->ff7_destroy_stats[eligible ? (bo->base.is_virtual ? 5 : 4) : 6]);
+   /* API lifetime requirements cover prior uses; kernel fallback still checks
+    * every removed mapping's backing lifetime, and keeps moves/TLB ordering.
+    * Never generalize this to driver-internal allocations freed while in use.
+    */
+   return eligible && ws->ff7_explicit_destroy ? FF7_VM_EXPLICIT : 0;
+}
+
+static void
+radv_amdgpu_ff7_destroy_done(struct radv_amdgpu_winsys *ws, bool explicit_sync, bool is_virtual, int result)
+{
+   if (ws->ff7_destroy_stats)
+      p_atomic_inc(&ws->ff7_destroy_stats[result ? 10 : explicit_sync ? (is_virtual ? 8 : 7) : 9]);
+   if (result)
+      fprintf(stderr, "FF7_E16: destruction VA operation failed (%d).\n", result);
+}
 
