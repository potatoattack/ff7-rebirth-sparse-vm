       return VK_SUCCESS;
@@ -193,8 +194,22 @@
    struct radeon_winsys *ws = device->ws;
    void *batch = NULL;
    VkResult result = VK_SUCCESS;
+   /* E12 is restricted to the hardware-queue path below. Before dropping
+    * VM-wide implicit application fences, complete the application's actual
+    * sparse waits. The runtime has already unwrapped semaphore payloads and
+    * handles wait-before-signal through its pending/submit-thread mechanism.
+    * Do not reset or consume these payloads here; normal submission handling
+    * still owns waits/signals and the completion fence.
+    */
+   bool explicit_unmap = allow_explicit && ws->ff7_explicit_unmap;
+   if (explicit_unmap) {
+      result = vk_sync_wait_many(&device->vk, submission->wait_count,
+                                 submission->waits, 0, UINT64_MAX);
+      if (result != VK_SUCCESS)
+         return result;
+   }
    if (ws->sparse_bind_begin) {
-      result = ws->sparse_bind_begin(ws, &batch);
+      result = ws->sparse_bind_begin(ws, explicit_unmap, &batch);
       if (result != VK_SUCCESS)
          return result;
    }
