-radv_queue_submit_bind_sparse_memory(struct radv_device *device, struct vk_queue_submit *submission)
+radv_queue_submit_bind_sparse_memory(struct radv_device *device, struct vk_queue_submit *submission,
+                                     bool allow_explicit)
 {
